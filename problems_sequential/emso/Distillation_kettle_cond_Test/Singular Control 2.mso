FlowSheet Singular
	
	PARAMETERS
	
	VARIABLES
	
	x1 as Real;
	x2 as Real;
	x3 as Real;
	u as Real;

	EQUATIONS
	
	if time < 1 then
	u = -1;
	else
	u = 1;
	end
	
	diff(x1) = x2;
	diff(x2) = u;
	diff(x3) = (x1)^2;
	
	INITIAL
	x1 = 0;
	x2 = 1;
	x3 = 0;
	
	OPTIONS
	TimeStep = 0.05;
	TimeEnd = 5;
	TimeUnit = 's';

end