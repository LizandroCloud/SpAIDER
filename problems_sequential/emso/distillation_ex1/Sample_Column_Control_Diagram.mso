FlowSheet Sample_Column_Control_Diagram
	PARAMETERS
	PP as Plugin(Brief="Physical Properties",
		Type="PP"
		,Components = ["propylene","propane"]
		,LiquidModel = "PR"
		,VapourModel = "PR"
	);
	NComp as Integer;
	SET
	NComp = PP.NumberOfComponents;

	DEVICES
	feed as simple_source;
