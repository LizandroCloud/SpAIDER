using "stage_separators/flash";

# exemplo baseado nos dados do artigo do Gani 1985.
FlowSheet flash_Test
	PARAMETERS
	PP as Plugin(Brief="Physical Properties",
		Type="PP",
		Components = ["1,3-butadiene", "isobutene", "n-pentane",
			"1-pentene", "1-hexene", "benzene"],
		LiquidModel = "PR",
		VapourModel = "PR"
	);
	NComp as Integer;

	VARIABLES
	
	Q	as energy_source (Brief="Heat supplied");
	Fr  as Real;
	To as Real;
	Lo as Real;
	x1o as Real;
	x2o as Real;
	x3o as Real;
	x4o as Real;
	x5o as Real;
	x6o as Real;
	
	SET
	NComp = PP.NumberOfComponents;
	
	DEVICES
	fl as flash;
	s1 as source;
	
	CONNECTIONS
	s1.Outlet to fl.Inlet;
	Q.OutletQ to fl.InletQ;
	
	EQUATIONS
	fl.OutletL.F = 400*sqrt(fl.Level/'m') * 'kmol/h';
	
	SPECIFY
	s1.F = Fr * 'kmol/h';
	s1.T = 338 * 'K';
	s1.P = 507.1 * 'kPa';
	s1.Composition = [0.2379,0.3082,0.09958,0.1373,0.08872,0.1283];

	fl.OutletV.F = 68.5 * 'kmol/h';
	Q.OutletQ.Q = 0 * 'kJ/h';
	Fr = 500;
	x1o = 0.5;
	x2o = 0.1;
	x3o = 0.1;
	x4o = 0.1;
	x5o = 0.1;
	x6o = 0.1;
	To = 338;
	Lo = 0.4;
	
	SET
	fl.V = 50 * 'm^3';
	fl.diameter = 2 * 'm';
	fl.orientation = "vertical";
#	fl.orientation = "horizontal";

	INITIAL
	fl.OutletL.T = To * 'K';
	fl.Level = Lo * 'm';

	fl.OutletL.z(1) = x1o;
	fl.OutletL.z(2) = x2o;
	fl.OutletL.z(3) = x3o;
	fl.OutletL.z(4) = x4o;
	fl.OutletL.z(5) = x5o;
	fl.OutletL.z(6) = x6o;
	
	OPTIONS
	
	Dynamic = true;
	DAESolver (File="pside");
	TimeStep = 10;
	TimeEnd = 200;
	TimeUnit = 's';
end

