LD     = "c:\program files\matlab\r2008a\sys\lcc\bin\lcclnk.exe"
LIBCMD = "c:\program files\matlab\r2008a\sys\lcc\bin\lcclib.exe"
CFLAGS = -c -Zp8 -DMATLAB_MEX_FILE -noregistrylookup
LDFLAGS = -s -dll -L"c:\program files\matlab\r2008a\sys\lcc\lib"
LIBFLAGS = 

OBJECTS = \
	"fcn3_sfun.obj"\
	"fcn3_sfun_registry.obj"\
	"c2_fcn3.obj"\
	"lccstub.obj"\
	"c:\program files\matlab\r2008a\sys\lcc\mex\lccdef.def"\
	"c:\program files\matlab\r2008a\stateflow\c\debugger\lib\win32\sfc_debuglcc.lib"\
	"c:\program files\matlab\r2008a\stateflow\c\mex\lib\win32\sfc_mexlcc.lib"\
	"c:\program files\matlab\r2008a\extern\lib\win32\lcc\libmex.lib"\
	"c:\program files\matlab\r2008a\extern\lib\win32\lcc\libmx.lib"\
	"c:\program files\matlab\r2008a\extern\lib\win32\lcc\libfixedpoint.lib"\
	"c:\program files\matlab\r2008a\extern\lib\win32\lcc\libut.lib"\
	"c:\program files\matlab\r2008a\toolbox\dspblks\lib\win32\dsp_dyn_rt_lcc.lib"\

INCLUDE_PATH= -I"c:\program files\matlab\r2008a\sys\lcc\include"  -I"c:\program files\matlab\r2008a\extern\include"  -I"c:\program files\matlab\r2008a\simulink\include"  -I"c:\program files\matlab\r2008a\stateflow\c\mex\include"  -I"c:\program files\matlab\r2008a\stateflow\c\debugger\include"  -I"c:\program files\matlab\r2008a\toolbox\eml\lib\dsp"  -I"c:\users\w7\dropbox\spaider_v4\problems_sequential\emso\optdyn\slprj\_sfprj\fcn3\_self\sfun\src"  -I"c:\users\w7\dropbox\spaider_v4\problems_sequential\emso\optdyn" 
 

fcn3_sfun.mexw32 : $(MAKEFILE) $(OBJECTS)
	$(LD) $(LDFLAGS) -o fcn3_sfun.mexw32 @fcn3_sfun.lmko
fcn3_sfun.obj :	"fcn3_sfun.c"
	$(CC) $(CFLAGS) $(INCLUDE_PATH) "fcn3_sfun.c"
fcn3_sfun_registry.obj :	"fcn3_sfun_registry.c"
	$(CC) $(CFLAGS) $(INCLUDE_PATH) "fcn3_sfun_registry.c"
c2_fcn3.obj :	"c2_fcn3.c"
	$(CC) $(CFLAGS) $(INCLUDE_PATH) "c2_fcn3.c"
lccstub.obj :	"c:\program files\matlab\r2008a\sys\lcc\mex\lccstub.c"
	$(CC) $(CFLAGS) $(INCLUDE_PATH) "c:\program files\matlab\r2008a\sys\lcc\mex\lccstub.c"
